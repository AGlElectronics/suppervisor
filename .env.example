# Development defaults only. Copy to .env; never commit real credentials.
POSTGRES_PASSWORD=suppervisor
POSTGRES_PORT=55432
API_PORT=8091
WEB_PORT=4179

# Leave empty to use deterministic seeded candidates.
# For the optional Compose service, run:
#   OLLAMA_URL=http://ollama:11434 docker compose --profile ollama up --build
OLLAMA_URL=
OLLAMA_MODEL=qwen3:8b
OLLAMA_PORT=11434

# Telegram is disabled while the token is empty. The allowlist is mandatory
# whenever a token is configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
